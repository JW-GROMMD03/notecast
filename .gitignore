cat << 'EOF' > .gitignore
# Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
backend/.env
backend/.env.*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# Node & Frontend Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
dist/
build/
EOF