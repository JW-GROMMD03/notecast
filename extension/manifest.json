{
  "manifest_version": 3,
  "name": "NoteCast",
  "version": "1.0.1",
  "description": "Turns any YouTube video you watch into verified, exportable study notes.",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "Open NoteCast",
    "default_icon": "assets/icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "desktopCapture",
    "tabCapture",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://notecast-53sj.onrender.com/*",
    "https://notecast-web.onrender.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://notecast-53sj.onrender.com/*",
      "https://notecast-web.onrender.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}