# Set to true once served over HTTPS — must be true in any real deployment,
# since browsers refuse to send Secure cookies over plain http.
COOKIE_SECURE=false
# Leave blank for local dev. In prod with subdomains (app.example.com /
# api.example.com) set to ".example.com" so the cookie is shared between them.
COOKIE_DOMAIN=

# Explicit web-app origins that are allowed to send/receive the session
# cookie. Must NOT be "*" — browsers reject wildcard origins on any
# credentialed (cookie-bearing) request. The extension isn't listed here;
# it authenticates via Bearer token, not cookies, so normal CORS doesn't
# apply to it the same way.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501



